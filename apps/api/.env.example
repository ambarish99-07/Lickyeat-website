# Copy to .env and fill in.
# NOTE: ports 4000 / 8081 / 3000 may be used by another local project — this
# stack defaults to 4100 (api) and 3100 (web) to avoid the collision.
PORT=4100
NODE_ENV=development

# MongoDB. For local dev without a real Mongo install, leave blank and the API
# spins up an in-memory mongodb-memory-server automatically (data is NOT
# persisted across restarts). Point at Atlas for a persistent dev database.
MONGODB_URI=

# Set to 1 to auto-seed demo data when the database is empty on boot — useful
# with the ephemeral in-memory Mongo, where `pnpm seed` runs in a separate
# process and can't share data with the dev server.
SEED_ON_BOOT=1

JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=30d

# CORS: comma-separated origins allowed to call the API.
WEB_ORIGIN=http://localhost:3100

# Razorpay (optional — COD works without it; Razorpay orders stay "pending"
# until a real key + signature verification succeed).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# WhatsApp Cloud API (optional — fail-silent if unset). Used to send the ops
# alert to your internal number and, once message templates are approved, the
# automated franchise/catering brief to the enquirer.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Public-facing Lickyeat contact. LICKYEAT_WHATSAPP_NUMBER powers the
# "Continue on WhatsApp" deep link shown after an enquiry — digits only, with
# country code, e.g. 919000000000.
LICKYEAT_WHATSAPP_NUMBER=
LICKYEAT_SUPPORT_EMAIL=

# Where new-lead / call-back alerts go when the admin panel is offline. All
# optional — the durable in-panel alert queue always works regardless. A
# call-back request raises a high-priority alert.
OPS_NOTIFY_EMAIL=
OPS_NOTIFY_WHATSAPP=
OPS_NOTIFY_WEBHOOK_URL=
# Resend HTTP API key — the no-SMTP way to actually deliver OPS_NOTIFY_EMAIL.
RESEND_API_KEY=
